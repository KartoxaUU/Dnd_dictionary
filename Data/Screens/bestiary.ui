       <property name="styleSheet">
        <string notr="true">QLabel {
    /* Заливка цветом с картинки */
    background-color: rgb(31, 39, 53);  
    
    /* Вспышка золота для текста и наш глобальный шрифт */
    color: rgb(240, 213, 163);
    font-family: &quot;Palatino Linotype&quot;;
    font-size: 14px; /* При необходимости подправьте размер */
    
    /* Скругление углов */
    border-radius: 6px;
    
    /* Внутренние отступы: 5px сверху/снизу, 10px слева/справа */
    padding: 5px 10px;
    
    /* Защита от системных рамок */
    border: none !important;
}</string>
