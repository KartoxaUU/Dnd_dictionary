       <property name="styleSheet">
        <string notr="true">/* ======================================================== */
/* 1. БАЗОВАЯ ПЛАШКА ТЕКСТОВОГО ПОЛЯ                        */
/* ======================================================== */
QTextEdit {
    background-color: rgb(31, 39, 53);   
    color: rgb(240, 213, 163);           
    border: 1px solid rgb(240, 213, 163); 
    border-radius: 4px;                  
    padding: 4px;                        
    font-family: &quot;Palatino Linotype&quot;;    
    font-size: 14px;
    font-weight: bold;
    selection-background-color: rgb(60, 83, 133);
    selection-color: rgb(255, 223, 160);
}

/* Принудительно делаем внутренний холст темным, чтобы не было белых вспышек */
QTextEdit QWidget {
    background-color: rgb(31, 39, 53);
    color: rgb(240, 213, 163);
}

/* ======================================================== */
/* 2. ТОНКАЯ ДОРОЖКА СКРОЛЛБАРА                             */
/* ======================================================== */
QScrollBar:vertical {
    background: transparent; 
    width: 8px;              /* Тонкий ползунок (8 пикселей) */
    margin: 0px;
    border: none;
}

/* ======================================================== */
/* 3. САМ БЕГУНОК (БЕЗ УГОЛКОВ И РАМОК)                     */
/* ======================================================== */
QScrollBar::handle:vertical {
    background: rgb(35, 57, 92);
    min-height: 30px;
    border-radius: 4px;      /* Идеальное скругление для ширины 8px */
    border: none; 
    margin: 0px;
}

QScrollBar::handle:vertical:hover {
    background: rgb(60, 83, 133);
}

QScrollBar::handle:vertical:pressed {
    background: rgb(31, 39, 53);
}

/* ======================================================== */
/* 4. УНИЧТОЖЕНИЕ СТРЕЛОК И БЕЛЫХ КВАДРАТОВ                 */
/* ======================================================== */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    width: 0px;
    border: none;
    background: none;
}

QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical {
    height: 0px;
    width: 0px;
    border: none;
    background: none;
}

/* Убираем белый фон пустых зон (над и под ползунком) */
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
}</string>
       </property>
