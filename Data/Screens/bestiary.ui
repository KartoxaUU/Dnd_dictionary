      <widget class="QTextEdit" name="textEdit_Capabilities_Create">
       <property name="geometry">
        <rect>
         <x>10</x>
         <y>940</y>
         <width>981</width>
         <height>261</height>
        </rect>
       </property>
       <property name="sizePolicy">
        <sizepolicy hsizetype="Fixed" vsizetype="Expanding">
