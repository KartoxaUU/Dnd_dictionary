     <property name="styleSheet">
      <string notr="true">/* Делаем саму область прокрутки прозрачной, но с золотой рамкой */
QScrollArea {
    background-color: transparent;
    border: 1px solid rgb(240, 213, 163) !important; /* Золотое обрамление */
    border-radius: 4px;                              /* Скругление углов, как у текст-эдита */
}

/* Холст внутри оставляем прозрачным */
QScrollArea &gt; QWidget &gt; QWidget {
    background-color: transparent;
}

/* ======================================================== */
/* 🛠 НАСТРОЙКА ВЕРТИКАЛЬНОГО ПОЛЗУНКА (SCROLLBAR) */
/* ======================================================== */

/* 1. Дорожка */
QScrollBar:vertical {
    background-color: rgb(233, 227, 212); 
    width: 10px;                         
    margin: 0px; 
    border-radius: 5px;                  
    border: none !important;
}

/* 2. Сам бегунок */
QScrollBar::handle:vertical {
    background-color: rgb(46, 64, 87);   
    min-height: 30px;                    
    border-radius: 5px;                  
    margin: 0px; 
    border: none !important; /* Убирает системные уголки, если они вдруг появятся */
}

/* 3. Наведение */
QScrollBar::handle:vertical:hover {
    background-color: rgb(240, 213, 163); 
}

/* 4. Зажатие */
QScrollBar::handle:vertical:pressed {
    background-color: rgb(31, 39, 53);     
}

/* 5. Убираем стрелочки */
QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    border: none;
    background: none;
    height: 0px;
}
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    border: none;
    background: none;
    height: 0px;
}

/* Убираем системный белый фон с пустых областей */
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}</string>
