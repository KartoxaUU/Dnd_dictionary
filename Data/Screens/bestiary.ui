       <property name="styleSheet">
        <string notr="true">/* ======================================================== */
/* 1. НАСТРОЙКА ОСНОВНОЙ ТЁМНО-СИНЕЙ ПЛАШКИ                 */
/* ======================================================== */
QComboBox {
    /* Наш глубокий тёмно-синий цвет для фона плашки */
    background-color: rgb(31, 39, 53);   
    
    /* ХИТРЫЙ ФИКС: Принудительный сброс нативного стиля Windows, чтобы цвет изменился */
    border-style: solid;
    border: 1px solid rgb(240, 213, 163); /* Золотая обводка */
    
    border-radius: 4px;
    padding: 4px 26px 4px 8px;                  
    
    color: rgb(240, 213, 163);           
    font-family: &quot;Palatino Linotype&quot;;    
    font-size: 14px;
    font-weight: bold;
    combobox-popup: 0;                   
}

/* ======================================================== */
/* 2. ФИКС ВЫЛЕТАЮЩЕЙ ПАНЕЛИ И СИНЕГО ВЫДЕЛЕНИЯ WINDOWS         */
/* ======================================================== */
QComboBox QAbstractItemView {
    background-color: rgb(31, 39, 53);     /* Тёмно-синий фон списка */
    color: rgb(240, 213, 163);             /* Золотые строчки */
    
    border: 1px solid rgb(240, 213, 163);   /* Золотой контур меню */
    border-radius: 4px;
    outline: none;                         /* Уничтожаем рамку фокуса */
    padding: 4px;
    
    /* ЖЕСТКИЙ ФИКС ДЛЯ ДЛИННОГО ТЕКСТА: Разрешаем списку раздуваться во все стороны */
    min-width: 240px;                      /* Увеличили базовый минимум под длинный урон */
}

/* Настройка самих строчек списка вариантов */
QComboBox QAbstractItemView::item {
    /* Добавляем больше отступа справа, чтобы текст не прижимался к скроллбару */
    padding: 6px 20px 6px 12px;                   
    min-height: 24px;                    
    font-family: &quot;Palatino Linotype&quot;;
    color: rgb(240, 213, 163);
}

/* Стираем синий виндовый цвет при наведении курсора */
QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background-color: rgb(45, 56, 76);     /* Наш приглушенный сине-стальной */
    color: rgb(255, 223, 160) !important;  /* Яркое золото */
}

/* ======================================================== */
/* 3. ЧУТЬ БОЛЕЕ СВЕТЛЫЙ МАТОВЫЙ ПОЛЗУНОК ПРОКРУТКИ            */
/* ======================================================== */
QComboBox QAbstractItemView QScrollBar:vertical {
    background-color: rgb(31, 39, 53);     /* Фон дорожки скролла */
    width: 10px;                           /* Тонкий и аккуратным */
    margin: 0px;
    border: none;
}

/* Сам бегунок — сделали чуть светлее (было 25, 43, 73) */
QComboBox QAbstractItemView QScrollBar::handle:vertical {
    background-color: rgb(35, 57, 92);     
    min-height: 20px;
    border-radius: 4px;                    
}

/* Подсветка бегунка при наведении (тоже сделали пропорционально светлее) */
QComboBox QAbstractItemView QScrollBar::handle:vertical:hover {
    background-color: rgb(52, 115, 186);   
}

/* Уничтожение стрелочек сверху и снизу у скроллбара */
QComboBox QAbstractItemView QScrollBar::add-line:vertical,
QComboBox QAbstractItemView QScrollBar::sub-line:vertical,
QComboBox QAbstractItemView QScrollBar::up-arrow:vertical, 
QComboBox QAbstractItemView QScrollBar::down-arrow:vertical,
QComboBox QAbstractItemView QScrollBar::add-page:vertical, 
QComboBox QAbstractItemView QScrollBar::sub-page:vertical {
    border: none;
    background: none;
    height: 0px;
}</string>
       </property>
      </widget>
