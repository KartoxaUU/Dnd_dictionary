        <string notr="true">QFrame {
    /* Плотная матовая заливка цветом с твоей картинки */
    background-color: rgb(30, 39, 51);
    
    /* ХИТРЫЙ ФИКС ДЛЯ QT: Сброс стиля рамок, чтобы скругление и обводка сработали вместе */
    border-style: solid;
    /* Роскошная золотая обводка толщиной 1px */
    border: 1px solid rgb(240, 213, 163); 
    
    /* Скругление углов (мягкий книжный стиль) */
    border-radius: 6px;
}

/* Автоматическая настройка для любых надписей внутри этого фрейма */
QFrame QLabel {
    background-color: transparent;
    color: rgb(240, 213, 163); /* Наше фирменное золото для текста */
    font-family: &quot;Palatino Linotype&quot;;
    /* Фикс: чтобы золотая обводка фрейма не наследовалась буквами текста */
    border: none !important; 
}</string>
