       <property name="styleSheet">
        <string notr="true">QPushButton {
    background-color: rgb(83, 73, 64);  /* Твой основной постоянный цвет (тёмная кожа) */
    color: rgb(240, 213, 163);          /* Золотой текст */
    border: none;                       /* Убираем рамки */
    border-radius: 4px;                 /* Скругление */
    padding: 6px 18px;                  /* Внутренние отступы */
    font-family: &quot;Palatino Linotype&quot;;   /* Наш глобальный шрифт */
    font-size: 20px;
}

/* Эффект при наведении мышки */
QPushButton:hover {
    background-color: rgb(105, 93, 82); /* Кнопка становится чуть светлее (выделяется из фона) */
    color: rgb(255, 223, 160);          /* Текст загорается ярким золотом */
}

/* Эффект при нажатии */
QPushButton:pressed {
    background-color: rgb(60, 53, 46);  /* Кнопка уходит в тень (становится темнее) */
    color: rgb(240, 213, 163);          /* Возвращаем базовый золотой цвет текста */
    
    /* Небольшой фикс для эффекта &quot;вдавливания&quot; (текст сдвигается на 1 пиксель вниз) */
    padding-top: 7px;
    padding-bottom: 5px;
}</string>
