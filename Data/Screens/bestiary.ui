       <property name="styleSheet">
        <string notr="true">QLineEdit {
    /* Базовый тёмно-синий DnD фон плашки */
    background-color: rgb(31, 39, 53);   
    
    /* ХИТРЫЙ ФИКС: Сброс стиля Windows для корректной работы рамок */
    border-style: solid;
    /* Золотая обводка толщиной 1px, как на твоем скриншоте */
    border: 1px solid rgb(240, 213, 163); 
    
    /* Аккуратное скругление углов */
    border-radius: 4px;                  
    
    /* Внутренние отступы: 4px сверху/снизу, 8px слева/справа, чтобы текст не лип к краям */
    padding: 4px 8px;                   
    
    /* Спокойное золото для вводимого текста и наш глобальный книжный шрифт */
    color: rgb(240, 213, 163);           
    font-family: &quot;Palatino Linotype&quot;;    
    font-size: 14px;
    font-weight: bold;
}

/* Эффект при наведении курсора мыши (Инпут мягко светлеет) */
QLineEdit:hover {
    background-color: rgb(45, 56, 76);   /* Тёмно-синий фон становится на пару тонов светлее */
}

/* Эффект в момент ввода текста (Когда кликнули внутрь инпута) */
QLineEdit:focus {
    background-color: rgb(31, 39, 53);   /* Возвращаем исходную плотность фона */
    border: 1px solid rgb(255, 223, 160); /* Золотая рамка загорается сочным, ярким светом */
}</string>
