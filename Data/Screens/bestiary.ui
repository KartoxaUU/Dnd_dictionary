     <property name="styleSheet">
      <string notr="true">/* ======================================================== */
/* 1. ИЗМЕНЕНО: ПРОЗРАЧНАЯ ПОДЛОЖКА СПИСКА                  */
/* ======================================================== */
QListWidget {
    /* Полностью прозрачный фон */
    background-color: transparent; 
    
    /* Сбрасываем нативный стиль Windows */
    border-style: solid;
    border: none !important;              
    
    /* Очистили отступы, чтобы плашки не сжимались внутри белого бокса */
    padding: 0px;    
    outline: 0 !important;                           
}

/* ======================================================== */
/* 2. НАСТРОЙКА ПЛАШЕК-ПОДКЛАССОВ ПО УМОЛЧАНИЮ              */
/* ======================================================== */
QListWidget::item {
    background-color: rgb(31, 39, 53);  
    color: rgb(240, 213, 163);          
    border-radius: 6px;                 
    padding: 10px 14px;                 
    margin-bottom: 8px;                 
    
    font-family: &quot;Palatino Linotype&quot;;   
    font-size: 13px;
    font-weight: bold;
    
    border: none !important;
}

/* ======================================================== */
/* 3. ЭФФЕКТ ПРИ НАВЕДЕНИИ КУРСОРA                          */
/* ======================================================== */
QListWidget::item:hover {
    background-color: rgb(50, 65, 87) !important;  
    color: rgb(240, 213, 163) !important;
    border: none !important;
}

/* ======================================================== */
/* 4. ЭФФЕКТ ПРИ ВЫДЕЛЕНИИ / НАЖАТИИ (ТЕМНЕЕТ)              */
/* ======================================================== */
QListWidget::item:selected, 
QListWidget::item:selected:active,
QListWidget::item:selected:focus {
    /* Глубокий бархатный полуночный тон */
    background-color: rgb(20, 26, 36) !important;  
    
    /* Приглушенное благородное золото для темного фонда */
    color: rgb(230, 205, 155) !important; 
    border: none !important;
}

/* ======================================================== */
/* 5. ГЛОБАЛЬНЫЙ ПРЕДОХРАНИТЕЛЬ ДЛЯ ВЫДЕЛЕНИЯ QT            */
/* ======================================================== */
QListWidget {
    selection-background-color: rgb(20, 26, 36);
    selection-color: rgb(230, 205, 155);
}</string>
