}

/* Эффект при наведении мышки */
QPushButton:hover {
    background-color: rgb(122, 69, 69); /* Винный цвет становится чуть светлее и ярче */
    color: rgb(255, 223, 160);          /* Текст загорается ярким золотом */
}

/* Эффект при нажатии */
