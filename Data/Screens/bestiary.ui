      <property name="styleSheet">
       <string notr="true">QPushButton {
    /* Твой основной глубокий матовый цвет */
    background-color: rgb(61, 75, 99);  
    
    /* Фирменное золото для текста */
    color: rgb(240, 213, 163);          
    font-family: &quot;Palatino Linotype&quot;;
    font-weight: bold;
    
    /* Полное удаление всех рамок и контуров */
    border: none !important;                       
    outline: none !important;
    
    border-radius: 0px; /* Легкое скругление для аккуратного вида */
    padding: 0px 0px;                  
}

/* Эффект при наведении курсора мыши */
QPushButton:hover {
    /* Шаг вверх (+12): мягкий, едва заметный блик из той же гаммы */
    background-color: rgb(73, 87, 111);  
    color: rgb(255, 223, 160); /* Текст чуть подсвечивается */
}

/* Эффект в момент самого клика (зажатия мыши) */
QPushButton:pressed {
    /* Шаг вниз (-13): цвет плавно уходит в глубокий, бархатный тон той же стали */
    background-color: rgb(48, 59, 79);  
    color: rgb(220, 195, 148);
}

/* КОГДА КНОПКА ВКЛЮЧЕНА (Зафиксирована в активном режиме) */
QPushButton:checked {
    /* Удерживает благородный глубокий тон, показывая, что фильтры открыты */
    background-color: rgb(48, 59, 79);  
    color: rgb(255, 223, 160);          
    border: none !important;
}</string>
