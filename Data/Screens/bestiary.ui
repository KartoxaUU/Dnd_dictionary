    <property name="styleSheet">
     <string notr="true">/* ======================================================== */
/* ТВОЙ ТЕКУЩИЙ КОД ДЛЯ ФРЕЙМА                              */
/* ======================================================== */
QFrame {
    background-color: rgb(55, 60, 70);
    border-radius: 10px; 
    border: none !important;
}

QFrame QLabel {
    color: rgb(240, 213, 163);
    font-family: &quot;Palatino Linotype&quot;;
}

/* ======================================================== */
/* НАСТРОЙКА LISTWIDGET (ФОН И ТЕКСТ)                       */
/* ======================================================== */
QListWidget {
    background-color: transparent; /* Чтобы фон фрейма просвечивал */
    border: none !important;
    color: rgb(240, 213, 163);
    font-family: &quot;Palatino Linotype&quot;;
    font-size: 14px;
    outline: 0; /* Убирает пунктирную рамку фокуса */
}

/* ======================================================== */
/* 🛠 ПОЛЗУНОК ДЛЯ LISTWIDGET (КАК У SCROLLAREA)            */
/* ======================================================== */

/* 1. Дорожка */
QListWidget QScrollBar:vertical {
    background-color: rgb(233, 227, 212); 
    width: 10px;                         
    margin: 0px; 
    border-radius: 5px;                  
    border: none !important;
}

/* 2. Сам бегунок */
QListWidget QScrollBar::handle:vertical {
    background-color: rgb(46, 64, 87);   
    min-height: 30px;                    
    border-radius: 5px;                  
    margin: 0px; 
    border: none !important; 
}

/* 3. Наведение */
QListWidget QScrollBar::handle:vertical:hover {
    background-color: rgb(240, 213, 163); 
}

/* 4. Зажатие */
QListWidget QScrollBar::handle:vertical:pressed {
    background-color: rgb(31, 39, 53);     
}

/* 5. Убираем стрелочки */
QListWidget QScrollBar::sub-line:vertical, 
QListWidget QScrollBar::add-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QListWidget QScrollBar::up-arrow:vertical, 
QListWidget QScrollBar::down-arrow:vertical {
    border: none;
    background: none;
    height: 0px;
}

/* Убираем системный белый фон с пустых областей */
QListWidget QScrollBar::add-page:vertical, 
QListWidget QScrollBar::sub-page:vertical {
    background: transparent;
}
</string>
    </property>
    <property name="frameShape">
     <enum>QFrame::Shape::StyledPanel</enum>
    </property>
    <property name="frameShadow">
     <enum>QFrame::Shadow::Raised</enum>
    </property>
    <widget class="QListWidget" name="listWidget_ChooseEditing">
     <property name="geometry">
