     <property name="styleSheet">
      <string notr="true">QCheckBox {
    background-color: transparent;      /* НАМЕРТВУ УБИРАЕМ ЛЮБОЙ ФОН ВОКРУГ ЧЕКБОКСА */
    color: rgb(240, 213, 163);          /* Яркое золото для текста названия */
    
    font-family: &quot;Palatino Linotype&quot;;   /* Твой книжный фэнтези-шрифт */
    font-size: 14px;
    font-weight: bold;
    spacing: 8px;                       /* Отступ между квадратиком и текстом */
}

/* НАСТРОЙКА КВАДРАТИКА (КОГДА ГАЛОЧКА НЕ СТОИТ) */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: rgb(240, 213, 163); /* Квадратик залит твоим золотым цветом */
    border: 1px solid rgb(240, 213, 163); /* Золотая аккуратная рамка */
    border-radius: 4px;                  /* Скругление углов квадратика */
}

/* ======================================================== */
/* 🎨 НАСТРОЙКА КВАДРАТИКА ПРИ НАЖАТИИ (КОГДА ГАЛОЧКА СТОИТ) */
/* ======================================================== */
QCheckBox::indicator:checked {
    background-color: rgb(133, 146, 158);    /* Квадратик изнутри заливается тёмно-синим цветом */
    border: 1px solid rgb(31, 39, 53);    /* Рамка подстраивается под синий цвет */
    

}</string>
