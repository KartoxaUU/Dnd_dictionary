      <string notr="true">QFrame {
    /* ТОТ САМЫЙ ГЛУБОКИЙ ТЁМНО-СИНИЙ ЦВЕТ ДЛЯ ФОНА ФРЕЙМА */
    background-color: rgb(31, 39, 53);  
    
    /* РОСКОШНАЯ ЗОЛОТАЯ ОБВОДКА (Толщина 1px, сплошная линия, наше фирменное золото) */
    border: 1px solid rgb(240, 213, 163);      
    
    /* НАДЁЖНОЕ СКРУГЛЕНИЕ УГЛОВ ПЛАШКИ */
    border-radius: 4px;                 
}

