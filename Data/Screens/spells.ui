         <property name="styleSheet">
          <string notr="true">/* Делаем саму область прокрутки и её холст прозрачными */
QScrollArea {
    background-color: transparent;
    border: none;
}
#scrollAreaWidgetContents {
    background-color: transparent;
}

/* ======================================================== */
/* 🛠 НАСТРОЙКА ВЕРТИКАЛЬНОГО ПОЛЗУНКА (SCROLLBAR) */
/* ======================================================== */

/* 1. Дорожка, по которой двигается ползунок */
QScrollBar:vertical {
    background-color: rgb(233, 227, 212);  /* Чуть более плотный пергаментный оттенок, чтобы выделяться */
    width: 10px;                         /* Аккуратная толщина линии */
    margin: 0px 0px 0px 0px;
    border-radius: 5px;                  /* Мягкое скругление дорожки */
}

/* 2. Сам бегунок (за который мы тянем мышкой) */
QScrollBar::handle:vertical {
    background-color: rgb(46, 64, 87);   /* Приглушённый стальной синий цвет (плотный и непрозрачный!) */
    min-height: 30px;                    /* Чтобы ползунок не сжимался в крошечную точку */
    border-radius: 5px;                  /* Круглые аккуратные края бегунка */
}

/* 3. Эффект при наведении курсора мыши */
QScrollBar::handle:vertical:hover {
    background-color: rgb(194, 150, 85); /* Загорается матовым D&amp;D золотом */
}

/* 4. Эффект, когда мы зажали ползунок кнопкой мыши */
QScrollBar::handle:vertical:pressed {
    background-color: rgb(114, 34, 43);  /* Становится благородным бордовым */
}

/* 5. Полностью убираем технические стрелочки Windows сверху и снизу */
QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    border: none;
    background: none;
    height: 0px;
}
QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
    border: none;
    background: none;
    height: 0px;
}</string>
