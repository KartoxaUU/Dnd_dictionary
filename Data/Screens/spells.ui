      <property name="styleSheet">
       <string notr="true">QPushButton {
    background-color: rgb(31, 39, 53);  /* Тёмно-синий цвет, как у кнопок классов */
    color: rgb(240, 213, 163);          /* Яркое золото для текста */
    border: none;                       /* Убираем рамки, чтобы была сплошная заливка */
    border-radius: 0px;                 /* Прямые углы в стиль вашей поисковой строки */
    padding: 6px 18px;                  /* Внутренние отступы */
}

/* Эффект при наведении мышки */
QPushButton:hover {
    background-color: rgb(45, 56, 76);  /* Кнопка становится чуть светлее */
}

/* Эффект при нажатии (Шаг 3 из нашего плана) */
QPushButton:pressed {
    background-color: rgb(45, 56, 76);  /* Темнеет в цвет главного фона */
    color: rgb(212, 163, 89);           /* Золото текста загорается ярче */
}</string>
