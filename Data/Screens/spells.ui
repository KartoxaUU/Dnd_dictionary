         <property name="styleSheet">
          <string notr="true">QListWidget {
    background-color: transparent;      /* Прозрачный фон списка */
    border: none;                       /* Убираем внешние рамки */
    outline: none;                      /* Отключаем пунктирные линии выбора */
}

/* Настройка внешнего вида элементов списка (строк с классами) */
QListWidget::item {
    background-color: rgb(31, 39, 53);  /* Тёмно-синий цвет плашки по умолчанию */
    color: rgb(240, 213, 163);          /* Спокойное золото для текста */
    border-radius: 8px;                 /* Скругление углов */
    padding: 12px 20px;                 /* Внутренние отступы */
    margin-bottom: 10px;                /* Расстояние между строками */
    

}

/* Эффект при наведении мышки */
QListWidget::item:hover {
    background-color: rgb(45, 56, 76);  /* Кнопка становится чуть светлее */
}

/* Эффект, когда класс в списке ВЫБРАН (на него нажали) */
QListWidget::item:selected {
    /* Фон остаётся вашим, тёмно-сине-стальным */
    background-color: rgb(41, 52, 71);  
    
    /* ТОТ САМЫЙ ЭФФЕКТ: золото текста загорается ярче и насыщеннее! */
    color: rgb(255, 223, 160);          
}</string>
