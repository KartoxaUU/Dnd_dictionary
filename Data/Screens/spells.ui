     <property name="styleSheet">
      <string notr="true">QComboBox {
    background-color: rgb(31, 39, 53);   /* Тёмно-синий DnD фон плашки */
    border: 1px solid rgb(240, 213, 163); /* Золотая рамка */
    border-radius: 4px;                  /* Скругление углов */
    padding: 4px 10px;                   /* Внутренние отступы */
    
    color: rgb(240, 213, 163);           /* Золото для текста */
    font-family: &quot;Palatino Linotype&quot;;    /* Книжный шрифт */
    font-size: 14px;
    font-weight: bold;

    /* СЕКРЕТНЫЙ ФИКС QT: Разрешает выпадающему меню быть шире самой кнопки! */
    combobox-popup: 0;                   
}

/* 2. НАСТРОЙКА ЗОНЫ СТРЕЛОЧКИ СПРАВА */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: none;                  /* Убираем лишние полосы */
}

/* НАДЁЖНЫЙ ВСТРОЕННЫЙ МЕТОД ДЛЯ СТРЕЛОЧКИ */
QComboBox::down-arrow {
    image: none;                        
    border-left: 5px solid transparent;  /* Золотой треугольник стрелочки */
    border-right: 5px solid transparent;
    border-top: 6px solid rgb(240, 213, 163); 
    width: 0px;
    height: 0px;
    margin-right: 2px;
}

/* ======================================================== */
/* 🎨 НАСТРОЙКА ВСПЛЫВАЮЩЕГО ОКНА С ВАРИАНТАМИ ВЫБОРА        */
/* ======================================================== */
QComboBox QAbstractItemView {
    background-color: rgb(31, 39, 53);   /* Тёмно-синий фон списка */
    color: rgb(240, 213, 163);           /* Золотые строчки вариантов */
    
    border: 1px solid rgb(240, 213, 163); /* Золотая рамка вокруг списка */
    border-radius: 4px;
    outline: none;
    padding: 4px;
    
    /* ФИКС ДЛЯ ЗАЩИТЫ ДЛИННОГО ТЕКСТА (&quot;ПРЕОБРАЗОВАНИЕ&quot;) */
    min-width: 160px;                    /* Принудительно раздуваем ширину выпадающей плашки */
}
QComboBox QAbstractItemView::item:hover {
    background-color: rgb(45, 56, 76);   /* Строчка становится чуть светлее */
    color: rgb(255, 223, 160);           /* Золото загорается ярче */
}

/* Настройка внешнего вида уже выбранного варианта в открытом меню */
QComboBox QAbstractItemView::item:selected {
    background-color: rgb(41, 52, 71);   /* Твой красивый сине-стальной цвет */
    color: rgb(255, 223, 160);
}
/* Настройка встроенной строки ввода для подсказки */
QComboBox QLineEdit {
    background: transparent;            /* Делаем подложку прозрачной */
    color: rgb(240, 213, 163);          /* Фирменное золото для текста подсказки */
    border: none;
    font-family: &quot;Palatino Linotype&quot;;
    font-size: 10px;
    font-weight: bold;
}

/* Настройка самих строчек списка вариантов */
QComboBox QAbstractItemView::item {
    padding: 6px 12px;                   /* Комфортные отступы вокруг слов */
    min-height: 24px;                    /* Высота строк, чтобы буквы не слипались */
}

/* Эффект при наведении мышки на строчку вариантов */
QComboBox QAbstractItemView::item:hover {
    background-color: rgb(45, 56, 76);   /* Строчка становится чуть светлее */
    color: rgb(255, 223, 160);           /* Золото загорается ярче */
}

/* Настройка внешнего вида уже выбранного варианта в открытом меню */
QComboBox QAbstractItemView::item:selected {
    background-color: rgb(41, 52, 71);   /* Твой красивый сине-стальной цвет */
    color: rgb(255, 223, 160);
}</string>
