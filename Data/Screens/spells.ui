/* 🎨 НАСТРОЙКА КВАДРАТИКА ПРИ НАЖАТИИ (КОГДА ГАЛОЧКА СТОИТ) */
/* ======================================================== */
QCheckBox::indicator:checked {
    background-color: rgb(133, 146, 158);    /* Квадратик изнутри заливается тёмно-синим цветом */
    border: 1px solid rgb(31, 39, 53);    /* Рамка подстраивается под синий цвет */
    

}</string>
